# Copy to .env on your host (or set these as environment variables).
# Never commit real credentials.

APP_ENV=production

DB_HOST=your-mysql-host
DB_PORT=3306
DB_NAME=digital_smart_class
DB_USER=your-mysql-user
DB_PASS=your-mysql-password

# Optional: import database/digital_smart_class.sql on first container boot.
# Long-running PHP hosts usually import the seed manually instead.
DB_IMPORT=0
